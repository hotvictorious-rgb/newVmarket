# ==============================================================================
# VICTORIOUS MARKET — PRODUCTION ENVIRONMENT CONFIGURATION
# Brand Promise: Your Trusted Online Market for Quality Products.
# Operating Philosophy: Trust First. Quality Always. Accountability at Every Stage.
# ==============================================================================

APP_NAME="Victorious Market"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://victoriousmarket.com.ng
API_URL=https://api.victoriousmarket.com.ng
MERCHANT_PORTAL_URL=https://shop.victoriousmarket.com.ng

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (MySQL 8.0+ / MariaDB 10.11+)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=victorious_prod
DB_USERNAME=victorious_user
DB_PASSWORD=REPLACE_WITH_SECURE_STRONG_DB_PASSWORD
DB_STRICT_MODE=true

# ------------------------------------------------------------------------------
# HIGH-THROUGHPUT DRIVERS & CACHING (REDIS)
# ------------------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.victoriousmarket.com.ng

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=REPLACE_WITH_SECURE_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY & ESCROW ENGINE (PAYSTACK NIGERIA LIVE)
# ------------------------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=pk_live_REPLACE_WITH_PAYSTACK_LIVE_PUBLIC_KEY
PAYSTACK_SECRET_KEY=sk_live_REPLACE_WITH_PAYSTACK_LIVE_SECRET_KEY
PAYSTACK_PAYMENT_URL=https://api.paystack.co
PAYSTACK_MERCHANT_EMAIL=payments@victoriousmarket.com.ng
PAYSTACK_WEBHOOK_SECRET=REPLACE_WITH_PAYSTACK_WEBHOOK_SECRET
PAYSTACK_CURRENCY=NGN

# ------------------------------------------------------------------------------
# MULTI-CHANNEL COMMERCE COMMUNICATIONS (TERMII SMS / OTP)
# ------------------------------------------------------------------------------
TERMII_API_KEY=REPLACE_WITH_LIVE_TERMII_API_KEY
TERMII_SENDER_ID=VMARKET
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_CHANNEL=generic
TERMII_OTP_TYPE=NUMERIC
TERMII_OTP_EXPIRY_MINUTES=10

# ------------------------------------------------------------------------------
# GOOGLE FIREBASE CLOUD MESSAGING (FCM) PUSH NOTIFICATIONS
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=victorious-market-prod
FIREBASE_CREDENTIALS_PATH=/var/www/victoriousmarket/backend/storage/credentials/firebase-service-account.json

# ------------------------------------------------------------------------------
# OBJECT STORAGE & CDN (CLOUDFLARE R2 / AWS S3 COMPATIBLE)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=auto
AWS_BUCKET=victorious-production-media
AWS_ENDPOINT=https://REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_URL=https://media.victoriousmarket.com.ng
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# SECURITY, BOT MITIGATION & CAPTCHA (CLOUDFLARE TURNSTILE)
# ------------------------------------------------------------------------------
TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY

# ------------------------------------------------------------------------------
# IDENTITY & GOOGLE OAUTH
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://victoriousmarket.com.ng/auth/google/callback

# ------------------------------------------------------------------------------
# DISASTER RECOVERY & OFF-SITE BACKUP INTEGRITY
# ------------------------------------------------------------------------------
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_BASE64_KEY
BACKUP_ARCHIVE_PASSWORD=REPLACE_WITH_SECURE_ZIP_PASSWORD
GOOGLE_DRIVE_BACKUP_FOLDER_ID=REPLACE_WITH_GOOGLE_DRIVE_FOLDER_ID
GOOGLE_DRIVE_CLIENT_ID=REPLACE_WITH_GOOGLE_DRIVE_CLIENT_ID
GOOGLE_DRIVE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_DRIVE_CLIENT_SECRET
GOOGLE_DRIVE_REFRESH_TOKEN=REPLACE_WITH_GOOGLE_DRIVE_REFRESH_TOKEN

# ------------------------------------------------------------------------------
# MAIL & TRANSACTIONAL RECEIPTS
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_MAIL_USER
MAIL_PASSWORD=REPLACE_WITH_MAIL_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@victoriousmarket.com.ng"
MAIL_FROM_NAME="Victorious Market"

# ------------------------------------------------------------------------------
# ENTERPRISE MONITORING (SENTRY ERROR REPORTING)
# ------------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# ------------------------------------------------------------------------------
# MAINTENANCE & DEPLOYMENT SECRET
# ------------------------------------------------------------------------------
DEPLOYMENT_MAINTENANCE_SECRET=REPLACE_WITH_RANDOM_SECRET_FOR_ZERO_DOWNTIME_BYPASS