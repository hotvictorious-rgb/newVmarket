# ==============================================================================
#                 VICTORIOUS MARKETPLACE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Duplicate this file as '.env' and populate your environment-specific credentials.
# All sensitive credentials must remain confidential and NEVER be committed to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
APP_NAME="Victorious Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Lagos
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 2. LOGGING & SYSTEM MONITORING
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# For quick local testing use 'sqlite'. For staging/production use 'mysql' or 'pgsql'.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=victorious_marketplace
# DB_USERNAME=vmarket_user
# DB_PASSWORD=StrongDatabasePassword123!

# Path to mysqldump binary (Required for production automated database backups)
MYSQLDUMP_PATH=mysqldump

# ------------------------------------------------------------------------------
# 4. SESSIONS, CACHING & BACKGROUND QUEUES
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
# CACHE_PREFIX=vmarket_cache

# Asynchronous Queue Connection (database or redis recommended for production Termii jobs)
QUEUE_CONNECTION=database

# Optional Redis / Memcached Cache & Session Broker
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (PAYSTACK NIGERIA)
# ------------------------------------------------------------------------------
# Required for Checkout Card/Bank/USSD/Transfer payments and Automated NUBAN Disbursements
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PAYMENT_URL=https://api.paystack.co
# Paystack webhook signatures are verified with PAYSTACK_SECRET_KEY (HMAC-SHA512).
# Do not set a separate webhook secret; Paystack's x-paystack-signature uses the API secret key.

# ------------------------------------------------------------------------------
# 6. SMS, OTP & WHATSAPP GATEWAYS (TERMII & NIGERIAN CARRIERS)
# ------------------------------------------------------------------------------
# Termii is the primary OTP and SMS alert provider for orders, riders, and vendors
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=VMARKET
TERMII_CHANNEL=dnd

# Meta WhatsApp Business Cloud API (For instant order status & handover updates)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional Secondary SMS Fallback Gateways
SMARTSMS_TOKEN=
SMARTSMS_SENDER_ID=VMARKET
EBULKSMS_USERNAME=
EBULKSMS_API_KEY=
EBULKSMS_SENDER_NAME=VMARKET
KUDISMS_TOKEN=
KUDISMS_SENDER=VMARKET
SENDCHAMP_PUBLIC_KEY=
SENDCHAMP_SENDER=Sendchamp

# ------------------------------------------------------------------------------
# 7. HIGH-SPEED MEDIA CDN & OBJECT STORAGE (CLOUDFLARE R2 / S3)
# ------------------------------------------------------------------------------
# 'public' stores on local disk (storage/app/public) for local development.
# 'r2' pushes WebP images to Cloudflare R2 bucket with 0 server egress bandwidth fees.
FILESYSTEM_DISK=local
MEDIA_DISK=public

CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=vmarket-media
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_ENDPOINT=https://<your_account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_URL=https://media.victoriousmarketplace.com
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=true

# Standard AWS S3 Fallback (if not using Cloudflare R2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# 8. AUTOMATED NIGHTLY DISASTER RECOVERY BACKUPS (GOOGLE DRIVE)
# ------------------------------------------------------------------------------
# Runs nightly at 02:00 AM WAT to dump DB, encrypt with AES-256, and upload offsite
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=storage/app/credentials/google-service-account.json
# Or specify inline credentials:
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
# Google Drive Folder ID where backup archives will be stored
GOOGLE_DRIVE_FOLDER_ID=
# Password for encrypting database backup ZIP archives
BACKUP_ENCRYPTION_KEY=YourStrongBackupEncryptionKey2026!
# Automatic cleanup policy: Backups older than this will be pruned from Google Drive
BACKUP_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 9. SUPER ADMIN & PLATFORM BOOTSTRAP IDENTITY
# ------------------------------------------------------------------------------
# Used by 'php artisan superadmin:sync-env' to seed or align initial Super Admin account
SUPERADMIN_NAME="Victorious Super Admin"
SUPERADMIN_EMAIL=admin@victoriousmarket.com.ng
SUPERADMIN_PASSWORD=ChangeThisPasswordInProduction!
SUPERADMIN_PHONE="+2348011110001"

# ------------------------------------------------------------------------------
# 10. CUSTOMER SUPPORT & MARKETPLACE CONTACT HOTLINES
# ------------------------------------------------------------------------------
SUPPORT_PHONE="09118949035"
SUPPORT_EMAIL="support@victoriousmarket.com.ng"
CALL_TO_ORDER_PHONE="+2349118949035"

# ------------------------------------------------------------------------------
# 11. GOOGLE OAUTH & SOCIAL LOGIN
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ------------------------------------------------------------------------------
# 12. EMAIL DISPATCH & SMTP CONFIGURATION
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@victoriousmarket.com.ng"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# 13. API SECURITY, SANCTUM & MOBILE APP CORS
# ------------------------------------------------------------------------------
# Comma-separated list of domains allowed for stateful SPA authentication
SANCTUM_STATEFUL_DOMAINS="localhost,localhost:3000,127.0.0.1,victoriousmarket.com.ng"
SANCTUM_TOKEN_PREFIX=vmarket_

# ------------------------------------------------------------------------------
# 14. DEMO & WORKBENCH MODES
# ------------------------------------------------------------------------------
# Set to 'false' in all staging and production environments to enforce full security
DEMO_MODE=false
VITE_APP_NAME="${APP_NAME}"
