<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive core files and dotfiles
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^\.git - [F,L,NC]
    RewriteRule ^composer\.(json|lock) - [F,L,NC]
    RewriteRule ^package(-lock)?\.json - [F,L,NC]
    RewriteRule ^artisan - [F,L,NC]
    RewriteRule ^storage/logs/ - [F,L,NC]

    # Automatically redirect all incoming web traffic into the public/ directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
